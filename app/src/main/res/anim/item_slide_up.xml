<?xml version="1.0" encoding="utf-8"?>
<!-- Entrada de cada item: sobe e aparece com leve zoom. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="420"
    android:interpolator="@android:interpolator/decelerate_quint">
    <translate
        android:fromYDelta="18%p"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />
</set>
