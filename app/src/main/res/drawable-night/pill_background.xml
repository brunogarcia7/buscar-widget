<?xml version="1.0" encoding="utf-8"?>
<!-- Variante tema escuro: gradiente de vidro mais contido. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:startColor="#3AFFFFFF"
        android:centerColor="#2EFFFFFF"
        android:endColor="#24FFFFFF"
        android:type="linear" />

    <corners android:radius="999dp" />

    <stroke
        android:width="1dp"
        android:color="@color/pill_stroke" />
</shape>
