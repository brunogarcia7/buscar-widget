<?xml version="1.0" encoding="utf-8"?>
<!--
    Fallback (tema escuro): pílula branca quase opaca, igual ao tema claro.
    Mantém a lupa/texto escuros do layout visíveis sobre qualquer wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:startColor="#FFFFFFFF"
        android:endColor="#F2F2F2F7"
        android:type="linear" />

    <corners android:radius="999dp" />

    <stroke
        android:width="1dp"
        android:color="#1A000000" />
</shape>
