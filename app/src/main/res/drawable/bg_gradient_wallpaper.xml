<?xml version="1.0" encoding="utf-8"?>
<!--
    Camada de CONTEÚDO (papel de parede) da tela — paleta MONOCROMÁTICA
    (preto / cinza / branco). Mesmo sem cor, mantém profundidade com um
    gradiente diagonal escuro e brilhos radiais em cinza claro, dando ao vidro
    algo para refletir e desfocar (liquid glass). O blur real vem do
    RenderEffect no código (API 31+).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: grafite -> quase preto, na diagonal. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF2A2A2E"
                android:centerColor="#FF1A1A1D"
                android:endColor="#FF0D0D0F"
                android:type="linear" />
        </shape>
    </item>
    <!-- Brilho cinza-claro no topo (luz difusa). -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="560dp"
                android:centerX="0.22"
                android:centerY="0.08"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Segundo brilho mais sutil embaixo à direita (profundidade). -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="460dp"
                android:centerX="0.92"
                android:centerY="0.9"
                android:startColor="#33BFBFBF"
                android:endColor="#00BFBFBF" />
        </shape>
    </item>
</layer-list>
